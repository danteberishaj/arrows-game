{
  "name": "ink-night-rn",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.18",
    "expo-asset": "~57.0.15",
    "expo-audio": "~57.0.4",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "patch-package": "^8.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "17.1.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "sharp": "^0.35.3",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "perf:core": "tsx scripts/perf/core-benchmark.ts",
    "perf:core:metadata": "tsx scripts/perf/core-benchmark.ts --metadata",
    "perf:android": "node scripts/perf/android/benchmark.mjs",
    "capture:android": "node scripts/perf/android/capture.mjs",
    "analysis:probe": "tsx scripts/analysis/difficulty-probe.ts"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-audio",
          "expo-haptics"
        ]
      },
      "apple": {
        "exclude": [
          "expo-audio",
          "expo-haptics"
        ]
      }
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "private": true,
  "packageManager": "npm@11.16.0"
}
