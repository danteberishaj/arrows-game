# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
/modules/*/android/build/

# Play upload keystore + passwords (backup: credentials.backup.enc)
/credentials/

# Encrypted keystore backup: the durable off-machine copy belongs in a password
# manager or a private repo, not in this public one.
credentials.backup.enc

# Local build artifacts and captures (release APKs here are signed with the upload key)
/artifacts/
